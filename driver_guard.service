# driver_guard.service
# ────────────────────
# systemd service for Driver Guard — starts automatically on Pi boot.
#
# Install:
#   sudo cp driver_guard.service /etc/systemd/system/driver_guard.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now driver_guard
#
# Status / logs:
#   systemctl status driver_guard
#   journalctl -u driver_guard -f
#
# Stop / disable autostart:
#   sudo systemctl stop driver_guard
#   sudo systemctl disable driver_guard

[Unit]
Description=Driver Guard
Documentation=https://github.com/Sourabh-kr823/DriverGuard
After=network.target sound.target
# Rate-limit crash loops (these belong in [Unit], not [Service])
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=sourabh
Group=sourabh
WorkingDirectory=/home/sourabh/Desktop/DriverGuard

ExecStart=/home/sourabh/Desktop/DriverGuard/.venv/bin/python main.py --config /home/sourabh/Desktop/DriverGuard/config.yaml

# Always come back — this runs unattended in the vehicle
Restart=always
RestartSec=5s

Environment="PYTHONUNBUFFERED=1"
# Lets espeak-ng voice alerts use the desktop PipeWire/Pulse audio session
# (falls back to ALSA if no session is running)
Environment="XDG_RUNTIME_DIR=/run/user/1000"
# API keys (OPENWEATHER_API_KEY, ...); leading '-' = ok if missing
EnvironmentFile=-/home/sourabh/Desktop/DriverGuard/.env

# Give camera / GPS time to initialise on boot
ExecStartPre=/bin/sleep 5

# Graceful stop — SIGTERM, wait 10s, then SIGKILL
TimeoutStopSec=10s
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=driver_guard

[Install]
WantedBy=multi-user.target
